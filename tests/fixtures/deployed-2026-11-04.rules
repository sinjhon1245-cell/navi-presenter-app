// 수업 내비 1단계-1 Firestore 보안 규칙
// 배포: 전용 프로젝트 navi-presenter-fd289에만, 교사 승인 뒤(firebase deploy --only firestore:rules). 설계는 docs/STAGE1-1-REALTIME.md
// 원칙: 구글로 로그인한 교사는 teachers/{자기 UID} 아래만 읽고 쓴다. PIN · 세션 이름을 알아도 그 교사가 아니면 거절. 그 밖은 모두 막는다.
// 학생 정보는 들어가지 않는다(반 이름 · 인원 수 · 교사의 신호등 판단 · 질문 메모 120자).
// 시험: tests/rules.spec.js(Firebase 에뮬레이터). 칸 이름을 바꾸면 앱(public/index.html의 lessonDeck · newDeck · defaultC · blankS)과 함께 바꾼다.
// PIN 4자리로 연결(docs/UX-1-1.md 9): PIN만으로는 아무것도 열리지 않는다. PIN은 교사 PC가 ‘휴대폰 연결’을 연 동안(3분)
// 그 교사 한 명이 잠깐 맡는 자리(pins/{PIN})일 뿐이고, 휴대폰은 거기에 요청 하나만 남긴다(기다리는 요청은 3개까지, 거절하면 비어요).
// 교사 PC가 허용한 휴대폰(익명 로그인) 한 대만, teachers/{교사}/devices/{그 휴대폰}이 있고 · 시간이 남았고 ·
// 허용받은 그 수업(run)이 아직 PC의 수업일 때만 읽는다. 수업 문서는 직접 쓰지 못하고 명령(cmds/{휴대폰})만 남긴다. 교사 PC가 검증해 적용한다.
// 이 부분은 실제 프로젝트에 교사 승인 뒤에만 배포한다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 수업 내비는 구글 로그인만 써요. 다른 방식(익명 · 이메일 등)으로 로그인한 계정은 자기 UID 자리라도 읽고 쓰지 못해요
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isGoogle() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // 시범 운영 교사(허용 목록): allowed/{교사 UID} 문서가 있는 구글 계정만 PIN 연결 자리를 열고 · 관리하고 · 휴대폰을 허용한다.
    // 목록은 관리자만 Firebase 콘솔에서 바꾼다(앱은 자기 문서가 있는지만 읽는다). 교사별 수업 접근(teachers/{자기 UID})은 구글 계정이면 그대로다.
    // 이 목록은 익명 계정의 PIN 자리 읽기나 무료 사용량 남용까지 막지는 않는다(docs/UX-1-1.md 11)
    function isTeacher() {
      return isGoogle() && exists(/databases/$(database)/documents/allowed/$(request.auth.uid));
    }
    function isAnon() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // 교사 PC가 허용한 휴대폰: 기기 문서가 있고, 끝나는 시각 전
    function devicePath(uid) {
      return /databases/$(database)/documents/teachers/$(uid)/devices/$(request.auth.uid);
    }
    function dev(uid) {
      return get(devicePath(uid)).data;
    }
    function isDevice(uid) {
      return isAnon() && exists(devicePath(uid)) && dev(uid).exp > request.time.toMillis();
    }
    function hubPath(uid) {
      return /databases/$(database)/documents/teachers/$(uid)/lessons/hub;
    }
    // 허용받은 수업(run)이 아직 교사 PC가 준비하거나 가르치는 수업일 때만. 수업이 끝나거나 PC가 새로 열리면 run이 바뀌어
    // PC가 기기 문서를 지우지 못하고 꺼졌어도(강제 종료 · 인터넷 끊김) 그 휴대폰은 다음 수업에 들어오지 못한다
    function inRun(uid) {
      return isDevice(uid) && exists(hubPath(uid)) && get(hubPath(uid)).data.get('run', '') == dev(uid).run;
    }
    function pinPath(p) {
      return /databases/$(database)/documents/pins/$(p);
    }
    function askPath(p) {
      return /databases/$(database)/documents/pins/$(p)/asks/$(request.auth.uid);
    }
    // PIN 자리에는 교사 id를 그대로 두지 않고 SHA-256(교사 id)만 둔다(누구나 하나씩 읽는 문서라서). 규칙이 직접 계산해 맞춰 본다
    function myHash() {
      return hashing.sha256(request.auth.uid).toHexString().lower();
    }

    // 선택 칸: 없거나(null 포함), 있으면 그 자료형 · 길이
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function optNumber(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }
    function optBool(d, k) {
      return !(k in d) || d[k] is bool;
    }
    function optList(d, k, max) {
      return !(k in d) || (d[k] is list && d[k].size() <= max);
    }

    // 세션 문서에 올 수 있는 칸. 개수 상한은 앱(80 · 40 · 80)보다 넉넉하게, 지나치게 커지는 것만 막는다
    function validSession(d) {
      return d.keys().hasOnly(['v', 'started', 'ended', 'cur', 't0', 'enteredAt', 'log', 'reactions', 'qs', 'used', 'tv', 'blank', 'tool', 'memoId', 'at', 'run'])
        && optString(d, 'run', 64)
        && optList(d, 'log', 300)
        && optList(d, 'reactions', 300)
        && optList(d, 'qs', 120)
        && optList(d, 'used', 200);
    }

    // 지금 수업 내용(lessons/deck): 예시 수업(lessonDeck) · 올린 파일 수업(newDeck)이 쓰는 칸만.
    // 장면(pages) · 수업 자료(res) 안쪽은 수업마다 달라서 목록 크기만 봐요(문서 하나는 Firestore가 1MiB로 막아요)
    function validDeck(d) {
      return d.keys().hasOnly(['v', 'kind', 'lessonId', 'key', 'oldKeys', 'title', 'tag', 'grade', 'subject', 'total', 'pages', 'res', 'prep', 'srcLink'])
        && d.keys().hasAll(['v', 'kind', 'title', 'pages', 'res'])
        && d.v is int
        && d.kind in ['example', 'pdf', 'pptx']
        && d.title is string && d.title.size() <= 200
        && d.pages is list && d.pages.size() <= 100
        && d.res is list && d.res.size() <= 400
        && optString(d, 'lessonId', 100)
        && optString(d, 'key', 300)
        && optString(d, 'tag', 300)
        && optString(d, 'subject', 40)
        && optString(d, 'srcLink', 1000)
        && optList(d, 'oldKeys', 20)
        && optNumber(d, 'grade')
        && optNumber(d, 'total')
        && (!('prep' in d) || d.prep in ['ai', 'basic']);
    }

    // 설정(lessons/settings): 앱의 발표 설정(defaultC)이 쓰는 칸만. PIN은 숫자 4자리, 반 이름은 짧게, 인원 수는 1–40
    function validSettings(d) {
      return d.keys().hasOnly(['v', 'monitor', 'presenter', 'strength', 'reactions', 'ai', 'theme', 'palette', 'pin', 'className', 'classSize',
          'fontSize', 'showConcepts', 'showNotes', 'showNext', 'pace', 'tapNav', 'liveTone'])
        && d.pin is string && d.pin.matches('[0-9]{4}')
        && optNumber(d, 'v')
        && optString(d, 'className', 40)
        && (!('classSize' in d) || (d.classSize is int && d.classSize >= 1 && d.classSize <= 40))
        && optString(d, 'monitor', 20)
        && optString(d, 'strength', 10)
        && optString(d, 'theme', 10)
        && optString(d, 'palette', 20)
        && optString(d, 'fontSize', 10)
        && optString(d, 'liveTone', 10)
        && optBool(d, 'presenter') && optBool(d, 'reactions') && optBool(d, 'ai')
        && optBool(d, 'showConcepts') && optBool(d, 'showNotes') && optBool(d, 'showNext')
        && optBool(d, 'pace') && optBool(d, 'tapNav');
    }

    // 교사 PC의 준비 상태(lessons/hub): PC가 상태가 바뀔 때만 쓰고, 휴대폰은 읽고 ‘수업 시작’ 요청(startReq)만 남긴다
    function validHub(d) {
      return d.keys().hasOnly(['v', 'on', 'pc', 'run', 'stage', 'title', 'scenes', 'offer', 'live', 'at', 'startReq', 'startAck', 'ping', 'pong'])
        && optNumber(d, 'v') && optNumber(d, 'scenes') && optNumber(d, 'at') && optString(d, 'run', 64)
        && optBool(d, 'on') && optBool(d, 'stage') && optBool(d, 'offer') && optBool(d, 'live')
        && optString(d, 'pc', 40) && optString(d, 'title', 200)
        && (!('startReq' in d) || d.startReq == null || (d.startReq is map && d.startReq.keys().hasOnly(['id', 'at', 'pc'])))
        && (!('startAck' in d) || d.startAck == null || (d.startAck is map && d.startAck.keys().hasOnly(['id', 'ok', 'why', 'at'])))
        && (!('ping' in d) || d.ping == null || (d.ping is map && d.ping.keys().hasOnly(['id', 'at'])))
        && (!('pong' in d) || d.pong == null || (d.pong is map && d.pong.keys().hasOnly(['id', 'at'])));
    }
    // 휴대폰의 명령 목록(cmds/{휴대폰}): 최근 것 몇 개만. 안쪽(넘기기 · 신호 …)은 교사 PC가 하나씩 검증해 적용한다
    function validCmd(d, v) {
      return d.keys().hasOnly(['sid', 'run', 'q', 'at', 'done', 'no'])
        && d.sid == v.sid && d.run == v.run
        && d.q is list && d.q.size() <= 10
        && d.at is number && optNumber(d, 'done') && optNumber(d, 'no');
    }
    // 허용한 휴대폰(devices/{휴대폰}): 그 수업 하나, 길어야 4시간
    function validDevice(d) {
      return d.keys().hasOnly(['sid', 'run', 'exp', 'at'])
        && d.sid is string && d.sid.matches('s[0-9]{4}')
        && d.run is string && d.run.size() >= 16 && d.run.size() <= 64
        && d.exp is number && d.exp <= request.time.toMillis() + 4 * 3600 * 1000
        && optNumber(d, 'at');
    }
    // PIN 자리(pins/{PIN}): 그 PIN의 수업(s{PIN}) 하나, 연 교사의 해시(owner)로, 길어야 5분(앱은 3분). lease는 열 때마다 새 난수.
    // asks: 받은 요청 수(한 번 열 때 20개까지) · no: 교사가 거절한 수. 답을 기다리는 요청(asks - no)은 3개까지
    function validPin(p, d) {
      return d.keys().hasOnly(['owner', 'sid', 'lease', 'exp', 'open', 'asks', 'no'])
        && d.owner == myHash()
        && d.sid == 's' + p
        && d.lease is string && d.lease.size() >= 16 && d.lease.size() <= 64
        && d.exp is number && d.exp <= request.time.toMillis() + 5 * 60 * 1000
        && d.open is bool && d.asks is int && d.no is int;
    }
    // 새로 열기: 열림 · 요청 0개 · 거절 0개
    function freshPin(p) {
      return validPin(p, request.resource.data) && request.resource.data.open == true
        && request.resource.data.asks == 0 && request.resource.data.no == 0;
    }
    // 휴대폰의 연결 요청: 그 자리의 lease · 누른 시각 · 기기 종류(‘iPhone’처럼 짧게)만. 학생 정보는 없다
    function validAsk(d) {
      return d.keys().hasOnly(['lease', 'at', 'kind'])
        && d.lease is string && d.at is number && optString(d, 'kind', 20);
    }

    match /teachers/{uid} {
      allow read, write: if false;

      // 지금 수업 내용(lessons/deck) · 설정(lessons/settings) · PC 준비 상태(lessons/hub). 교사 PC가 쓰고 휴대폰은 읽는다
      match /lessons/{name} {
        allow read: if isOwner(uid) || (name in ['deck', 'settings', 'hub'] && inRun(uid));
        allow create, update: if isOwner(uid)
          && ((name == 'deck' && validDeck(request.resource.data))
            || (name == 'settings' && validSettings(request.resource.data))
            || (name == 'hub' && validHub(request.resource.data)));
        // PIN으로 연결한 휴대폰은 ‘수업 시작’ 요청과 ‘PC 응답 확인’ 칸만 바꿀 수 있다(시작은 교사 PC가 한다)
        allow update: if name == 'hub' && inRun(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startReq', 'ping'])
          && validHub(request.resource.data);
        allow delete: if false;
      }

      // 수업 진행 상태(sessions/s{수업 번호}). PIN 휴대폰은 허용받은 그 수업(run)만 읽고, 쓰지는 못한다
      match /sessions/{sid} {
        allow read: if isOwner(uid) || (inRun(uid) && dev(uid).sid == sid && resource.data.get('run', '') == dev(uid).run);
        allow create, update: if isOwner(uid) && sid.matches('s[0-9]{4}') && validSession(request.resource.data);
        allow delete: if false;
      }

      // PIN 휴대폰의 명령: 자기 문서 하나에만, 허용받은 그 수업으로만. 교사 PC는 읽고 ‘처리함(done) · 거절(no)’만 적는다
      match /cmds/{phone} {
        allow read: if isOwner(uid) || (request.auth != null && request.auth.uid == phone && inRun(uid));
        allow create: if request.auth != null && request.auth.uid == phone && inRun(uid)
          && validCmd(request.resource.data, dev(uid)) && request.resource.data.keys().hasOnly(['sid', 'run', 'q', 'at']);
        allow update: if request.auth != null && request.auth.uid == phone && inRun(uid)
          && validCmd(request.resource.data, dev(uid)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sid', 'run', 'q', 'at']);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'no'])
          && optNumber(request.resource.data, 'done') && optNumber(request.resource.data, 'no');
        allow delete: if isOwner(uid);
      }

      // 교사 PC가 허용한 휴대폰. 교사만 만들고 지운다(수업 끝 · 연결 끊기)
      match /devices/{phone} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isTeacher() && validDevice(request.resource.data);
      }
    }

    // 시범 교사 목록: 자기 문서가 있는지만 읽는다. 목록 보기 · 쓰기는 아무도 못 한다(관리자는 콘솔에서)
    match /allowed/{who} {
      allow get: if request.auth != null && request.auth.uid == who;
      allow list, write: if false;
    }

    // PIN 자리: 한 PIN은 한 번에 한 교사만 맡는다(같은 PIN을 쓰는 다른 교사의 수업과 섞이지 않게).
    // 들어 있는 것은 교사 해시 · 수업 이름(s{PIN}) · lease · 끝나는 시각 · 요청 수뿐이라(교사 id 없음), 로그인한 누구나 하나씩은 읽을 수 있다(목록은 아무도 못 본다)
    match /pins/{p} {
      allow get: if request.auth != null;
      allow list, delete: if false;
      allow create: if isTeacher() && p.matches('[0-9]{4}') && freshPin(p);
      // 다시 열기(새 lease): 내 자리이거나, 남의 자리라도 닫혔거나 시간이 지났을 때만
      allow update: if isTeacher() && freshPin(p) && request.resource.data.lease != resource.data.lease
        && (resource.data.owner == myHash() || resource.data.open == false || resource.data.exp <= request.time.toMillis());
      // 닫기: 맡은 교사만
      allow update: if isTeacher() && resource.data.owner == myHash()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']) && request.resource.data.open == false;
      // 거절 하나: 맡은 교사가 요청에 ‘거절’을 적으며 거절 수를 하나 올린다. 그만큼 기다리는 자리가 다시 비어서,
      // 모르는 요청이 자리를 채워도 교사가 거절하면 내 휴대폰이 들어올 수 있다
      allow update: if isTeacher() && resource.data.owner == myHash()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['no'])
        && request.resource.data.no == resource.data.no + 1 && request.resource.data.no <= resource.data.asks;
      // 휴대폰(익명)은 자기 요청 하나를 남기며 요청 수를 하나 올린다: 열려 있고 · 시간 전이고 · 기다리는 요청이 3개 미만이고 ·
      // 한 번 연 동안 20개 미만이고 · 이 lease에 처음이고 · 이 PIN에서 거절된 휴대폰이 아닐 때만
      allow update: if isAnon()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asks'])
        && resource.data.open == true && resource.data.exp > request.time.toMillis()
        && resource.data.asks < 20 && resource.data.asks - resource.data.no < 3
        && request.resource.data.asks == resource.data.asks + 1
        && getAfter(askPath(p)).data.lease == resource.data.lease
        && (!exists(askPath(p)) || (get(askPath(p)).data.lease != resource.data.lease && get(askPath(p)).data.get('no', false) != true));

      match /asks/{phone} {
        function pin() {
          return get(pinPath(p)).data;
        }
        function mine() {
          return isAnon() && request.auth.uid == phone;
        }
        // 요청 수를 함께 올리는 같은 한 번의 쓰기여야 한다(그래서 자리마다 3개를 넘지 못한다)
        function counted() {
          return validAsk(request.resource.data) && request.resource.data.lease == pin().lease
            && getAfter(pinPath(p)).data.asks == pin().asks + 1;
        }
        allow get: if request.auth != null && request.auth.uid == phone;
        // 교사는 지금 lease의 요청만 본다(앞서 이 PIN을 맡았던 다른 교사의 요청은 못 본다)
        allow read: if isTeacher() && pin().owner == myHash() && resource.data.lease == pin().lease;
        allow create: if mine() && counted();
        // 지난 lease에 남은 내 요청 자리에 새로 요청(거절된 적이 있으면 안 된다. 앱은 거절되면 새 익명 계정으로 다시 요청해요)
        allow update: if mine() && resource.data.lease != pin().lease && resource.data.get('no', false) != true && counted();
        // 휴대폰의 ‘취소’와 다시 요청(같은 lease 안에서는 요청 수가 늘지 않는다). 교사가 답한 뒤에는 못 바꾼다
        allow update: if mine() && resource.data.lease == pin().lease
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gone', 'at'])
          && request.resource.data.gone is bool && request.resource.data.at is number
          && !('ok' in resource.data) && !('no' in resource.data);
        // 교사의 답: 지금 lease의 요청에만. 거절은 언제나, 허용은 자리가 열려 있고 시간 전일 때 자기 이름 · 그 PIN의 수업으로만
        allow update: if isTeacher() && pin().owner == myHash() && resource.data.lease == pin().lease
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok', 'no', 'teacher', 'sid'])
          && !('ok' in resource.data) && !('no' in resource.data)
          && ((request.resource.data.get('no', false) == true && !('ok' in request.resource.data))
            || (request.resource.data.get('ok', false) == true && !('no' in request.resource.data)
              && request.resource.data.get('teacher', '') == request.auth.uid && request.resource.data.get('sid', '') == pin().sid
              && pin().open == true && pin().exp > request.time.toMillis() && resource.data.get('gone', false) == false));
        allow delete: if false;
      }
    }
  }
}
